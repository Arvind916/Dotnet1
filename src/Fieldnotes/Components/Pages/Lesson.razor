@page "/concept/{Id}"
@inherits StudyPageBase
@inject NavigationManager Navigation

@if (concept is not null)
{
    <PageTitle>@concept.Title | Fieldnotes</PageTitle>
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="library">Concept library</a><Icon Name="chevron-right" /><a href="@($"library?track={Uri.EscapeDataString(concept.Track)}")">@concept.Track</a><Icon Name="chevron-right" /><span>Lesson @LessonNumber</span></nav>
    <div class="lesson-heading"><div class="lesson-title-meta"><span class="track-icon tone-@Presentation.TrackTone(concept.Track)"><Icon Name="@Presentation.TrackIcon(concept.Track)" /></span><span class="level level-@concept.Level.ToLowerInvariant()">@concept.Level</span><span class="small-meta"><Icon Name="clock-3" />@concept.Minutes min read</span></div><h1>@concept.Title</h1><p>@concept.Summary</p></div>
    <div class="lesson-toolbar">
        <div class="segmented-control" role="group" aria-label="Lesson format">
            <button class="@(!quickMode ? "active" : "")" aria-pressed="@(!quickMode ? "true" : "false")" @onclick="() => quickMode = false"><Icon Name="align-left" />Full lesson</button>
            <button class="@(quickMode ? "active" : "")" aria-pressed="@(quickMode ? "true" : "false")" @onclick="() => quickMode = true"><Icon Name="zap" />Quick notes</button>
        </div>
        <div class="lesson-actions">
            <button class="icon-button @(Progress?.IsBookmarked == true ? "is-saved" : "")"
                    title="@(Progress?.IsBookmarked == true ? "Remove bookmark" : "Bookmark lesson")"
                    aria-label="@(Progress?.IsBookmarked == true ? "Remove bookmark" : "Bookmark lesson")"
                    aria-pressed="@(Progress?.IsBookmarked == true ? "true" : "false")" disabled="@IsBusy" @onclick="() => BookmarkAsync(Id)">
                <Icon Name="bookmark" />
            </button>
            <button class="button @(Progress?.IsCompleted == true ? "completed-button" : "secondary")" disabled="@IsBusy" @onclick="ToggleCompletedAsync">
                <Icon Name="@(Progress?.IsCompleted == true ? "circle-check" : "check")" />@(Progress?.IsCompleted == true ? "Completed" : "Mark complete")
            </button>
        </div>
    </div>
    <ErrorNotice Message="@Error" />
    <div class="lesson-layout">
        <article class="lesson-content" @key="Id">
            <section class="takeaways" id="essentials"><div class="eyebrow accent"><Icon Name="sparkles" />The essentials</div><ul>@foreach (var takeaway in concept.Takeaways) { <li><Icon Name="check" /><span>@takeaway</span></li> }</ul></section>
            @if (!quickMode)
            {
                <section class="lesson-section" id="idea"><div class="section-number">01 <span>The idea</span></div><h2>Let's make it click.</h2><p>@concept.Explanation</p><h3>Why we use it</h3><p>@concept.Why</p></section>
                <section class="lesson-section" id="simple-example"><div class="section-number">02 <span>A small example</span></div><h2>Start with the essentials.</h2><CodeBlock @key="@($"{Id}-simple")" Code="@concept.SimpleCode" Language="@(Id == "sql" ? "sql" : Id == "cicd" ? "bash" : "csharp")" Label="@(Id == "sql" ? "SQL" : Id == "cicd" ? "Terminal" : "C# / Simple example")" /></section>
            }
            <section class="lesson-section" id="practice"><div class="section-number">@(quickMode ? "01" : "03") <span>In the real world</span></div><h2>Where this shows up.</h2><p>@concept.UseCase</p><h3>When to use it</h3><p>@concept.WhenToUse</p>
                @if (!quickMode)
                {
                    <CodeBlock @key="@($"{Id}-practical")" Code="@concept.PracticalCode" Language="@(Id == "cicd" ? "yaml" : "csharp")" Label="@(Id == "cicd" ? "GitHub Actions / Workflow" : "C# / Practical example")" />
                }
            </section>
            <section class="lesson-section" id="tradeoffs"><div class="tradeoff-grid"><div><h3><Icon Name="circle-alert" />Common mistakes</h3><ul>@foreach (var pitfall in concept.Pitfalls) { <li>@pitfall</li> }</ul></div><div><h3><Icon Name="circle-check" />Good habits</h3><ul>@foreach (var practice in concept.BestPractices) { <li>@practice</li> }</ul></div></div></section>
            <section class="lesson-section" id="interview"><div class="section-number">@(quickMode ? "02" : "04") <span>The interview angle</span></div><h2>Be ready for these.</h2><div class="interview-questions">@foreach (var question in concept.Interview)
                {
                    <details><summary><Icon Name="message-circle" /><span>@question.Question</span><Icon Name="chevron-down" /></summary><p>@question.Answer</p></details>
                }</div><a href="@($"practice?concept={Id}")" class="button secondary"><Icon Name="circle-help" />Practice this concept<Icon Name="arrow-right" /></a></section>
            <section class="lesson-section related-section" id="connections"><div class="section-heading"><h2>Connect the dots</h2><a class="text-link" href="@concept.DocsUrl" target="_blank" rel="noopener noreferrer">Microsoft documentation<Icon Name="external-link" /></a></div><div class="related-links">@foreach (var relatedId in concept.Related)
                {
                    var related = Catalog.Find(relatedId)!;
                    <a href="@($"concept/{relatedId}")"><span class="track-icon tone-@Presentation.TrackTone(related.Track)"><Icon Name="@Presentation.TrackIcon(related.Track)" /></span><span>@related.Title</span><Icon Name="arrow-up-right" /></a>
                }</div></section>
            <div class="lesson-bottom">
                <div><span class="eyebrow">One more concept in your toolkit</span><h3>@(Progress?.IsCompleted == true ? "This chapter is checked off." : "Ready to call this one complete?")</h3></div>
                <button class="button @(Progress?.IsCompleted == true ? "secondary" : "primary")" disabled="@IsBusy" @onclick="ToggleCompletedAsync">
                    <Icon Name="circle-check" />@(Progress?.IsCompleted == true ? "Mark incomplete" : "Mark complete")
                </button>
            </div>
            <nav class="lesson-pagination" aria-label="Adjacent lessons">@if (Previous is not null) { <a href="@($"concept/{Previous.Id}")"><Icon Name="arrow-left" /><span><small>Previous concept</small>@Previous.Title</span></a> } else { <span></span> }@if (Next is not null) { <a href="@($"concept/{Next.Id}")" class="next-lesson"><span><small>Up next</small>@Next.Title</span><Icon Name="arrow-right" /></a> }</nav>
        </article>
        <aside class="lesson-outline"><div class="eyebrow">On this page</div><a href="@SectionLink("essentials")">The essentials</a>@if (!quickMode) { <a href="@SectionLink("idea")">The idea</a><a href="@SectionLink("simple-example")">A small example</a> }<a href="@SectionLink("practice")">In the real world</a><a href="@SectionLink("tradeoffs")">Mistakes & good habits</a><a href="@SectionLink("interview")">Interview questions</a><a href="@SectionLink("connections")">Related concepts</a><div class="outline-divider"></div><a href="@($"practice?concept={Id}")" class="outline-practice"><Icon Name="circle-help" />Test your knowledge</a></aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery(Name = "quick")] public bool Quick { get; set; }
    private Concept? concept;
    private string? loadedId;
    private bool quickMode;
    private LearningProgress? Progress => Snapshot.For(Id);
    private int LessonNumber => Catalog.All.ToList().FindIndex(item => item.Id == Id) + 1;
    private Concept? Previous => LessonNumber > 1 ? Catalog.All[LessonNumber - 2] : null;
    private Concept? Next => LessonNumber < Catalog.All.Count ? Catalog.All[LessonNumber] : null;
    private string SectionLink(string fragment) => new UriBuilder(Navigation.Uri) { Fragment = fragment }.Uri.AbsoluteUri;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id) return;
        concept = Catalog.Find(Id);
        loadedId = Id;
        quickMode = Quick;
        if (concept is null)
        {
            Navigation.NotFound();
            return;
        }

        await SaveAsync(() => Study.RecordReadAsync(Id));
    }

    private async Task ToggleCompletedAsync() => await SaveAsync(() => Study.ToggleCompletedAsync(Id));
}