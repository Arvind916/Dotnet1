@page "/practice"
@inherits StudyPageBase

<PageTitle>Quiz practice | Fieldnotes</PageTitle>
<div class="page-heading"><div><div class="eyebrow">A little challenge goes a long way</div><h1>Quiz practice<span class="heading-dot">.</span></h1><p>@Catalog.All.Sum(item => item.Quiz.Length) questions. Real interview thinking.</p></div><a href="revision" class="button secondary"><Icon Name="layers" />Flashcards</a></div>
<ErrorNotice Message="@Error" />
@if (!started)
{
    <section class="practice-setup">
        <div class="section-heading"><h2>Your next practice session</h2><span class="small muted">@AvailableQuestions.Count questions available</span></div>
        @if (focusedConcept is not null)
        {
            <div class="focused-topic"><Icon Name="target" /><span>@focusedConcept.Title</span><button class="icon-button" aria-label="Remove concept focus" title="Remove concept focus" @onclick="ClearFocus"><Icon Name="x" /></button></div>
        }
        <div class="setup-fields"><label><span>Learning path</span><select @bind="selectedTrack" disabled="@(focusedConcept is not null)"><option value="">All learning paths</option>@foreach (var track in Catalog.Tracks) { <option>@track</option> }</select></label><label><span>Session length</span><select @bind="questionCount"><option value="5">5 questions</option><option value="10">10 questions</option><option value="15">15 questions</option></select></label><button class="button primary" @onclick="StartSession" disabled="@(!IsReady || AvailableQuestions.Count == 0)">Start @Math.Min(questionCount, AvailableQuestions.Count) questions<Icon Name="arrow-right" /></button></div>
    </section>
    <section class="practice-overview"><div class="practice-number"><span class="track-icon tone-blue"><Icon Name="target" /></span><strong>@(Snapshot.Attempts.Count == 0 ? "-" : $"{Snapshot.Accuracy}%")</strong><span>All-time accuracy</span></div><div class="practice-number"><span class="track-icon tone-coral"><Icon Name="circle-help" /></span><strong>@Snapshot.Attempts.Count</strong><span>Questions answered</span></div><div class="practice-number"><span class="track-icon tone-gold"><Icon Name="refresh-cw" /></span><strong>@Snapshot.Progress.Count(StudyPlanner.IsWeak)</strong><span>Concepts to strengthen</span></div></section>
    <section class="history-section"><div class="section-heading"><h2>Recent answers</h2><a href="progress" class="text-link">All progress<Icon Name="arrow-up-right" /></a></div>
        @if (Snapshot.Attempts.Count == 0)
        {
            <div class="empty-state compact-empty"><span class="empty-icon"><Icon Name="pencil-line" /></span><h3>No answers on the page yet.</h3><p>Your first session starts a new chapter.</p></div>
        }
        else
        {
            <div class="answer-history">@foreach (var attempt in Snapshot.Attempts.Take(8))
                {
                    <a href="@($"concept/{attempt.ConceptId}")"><span class="answer-state @(attempt.IsCorrect ? "correct" : "incorrect")"><Icon Name="@(attempt.IsCorrect ? "check" : "x")" /></span><div><strong>@(Catalog.Find(attempt.ConceptId)?.Title ?? attempt.ConceptId)</strong><span>@(attempt.IsCorrect ? "Correct answer" : "Worth another look")</span></div><time>@Presentation.Since(attempt.AnsweredAt, Now)</time><Icon Name="arrow-up-right" /></a>
                }</div>
        }
    </section>
}
else if (finished)
{
    <section class="quiz-results" aria-live="polite"><span class="result-symbol"><Icon Name="flag" /></span><div class="eyebrow">Practice session complete</div><h2>Another step forward.</h2><div class="result-score">@StudyPlanner.Accuracy(results.Count(item => item.Correct), results.Count)<span>%</span></div><p><strong>@results.Count(item => item.Correct) of @results.Count answered correctly.</strong> @results.Count of @questions.Count questions attempted.</p><div class="result-actions"><button class="button primary" @onclick="ResetSession">New session<Icon Name="refresh-cw" /></button><a href="progress" class="button secondary">View progress<Icon Name="arrow-right" /></a></div></section>
    <section class="session-review"><div class="section-heading"><h2>Your session, at a glance</h2><a class="text-link" href="revision?mode=weak">Review weak topics<Icon Name="arrow-right" /></a></div><div class="answer-history">@foreach (var result in results)
        {
            <a href="@($"concept/{result.Item.Concept.Id}")"><span class="answer-state @(result.Correct ? "correct" : "incorrect")"><Icon Name="@(result.Correct ? "check" : "x")" /></span><div><strong>@result.Item.Question.Question</strong><span>@result.Item.Concept.Title</span></div><Icon Name="arrow-up-right" /></a>
        }</div></section>
}
else if (Current is not null)
{
    <div class="quiz-workspace">
        <div class="quiz-session-bar">
            <span>Question <strong>@(questionIndex + 1)</strong> of @questions.Count</span>
            <span class="small muted">@results.Count(item => item.Correct) correct</span>
            <button class="button ghost" @onclick="EndSession" disabled="@IsBusy">End session</button>
        </div>
        <progress class="quiz-progress" max="@questions.Count" value="@results.Count" aria-label="Questions answered"></progress>
        <section class="question-panel" @key="Current.Question.Id"><div class="question-meta"><span class="track-icon tone-@Presentation.TrackTone(Current.Concept.Track)"><Icon Name="@Presentation.TrackIcon(Current.Concept.Track)" /></span><span>@Current.Concept.Title</span><span class="level level-@Current.Concept.Level.ToLowerInvariant()">@Current.Concept.Level</span></div><h2 id="quiz-question" tabindex="-1" @ref="questionHeading">@Current.Question.Question</h2><fieldset class="answer-options" aria-labelledby="quiz-question" disabled="@(graded is not null || IsBusy)">
                @for (var optionIndex = 0; optionIndex < Current.Question.Options.Length; optionIndex++)
                {
                    var choice = optionIndex;
                    <label class="answer-option @OptionClass(choice)"><input type="radio" name="quiz-answer" value="@choice" checked="@(selectedAnswer == choice)" @onchange="() => selectedAnswer = choice" /><span class="option-letter">@((char)('A' + choice))</span><span>@Current.Question.Options[choice]</span>@if (graded is not null && choice == Current.Question.CorrectIndex) { <Icon Name="circle-check" /> } else if (graded == false && selectedAnswer == choice) { <Icon Name="circle-x" /> }</label>
                }
            </fieldset>
            @if (graded is not null)
            {
                <div class="answer-feedback @(graded == true ? "correct" : "incorrect")" role="status"><h3><Icon Name="@(graded == true ? "circle-check" : "circle-help")" />@(graded == true ? "That's right." : "Not quite. Here's the distinction.")</h3><p>@Current.Question.Explanation</p><a href="@($"concept/{Current.Concept.Id}")" class="text-link" target="_blank" rel="noopener noreferrer">Open the lesson<Icon Name="external-link" /></a></div>
            }
            <div class="question-actions"><span class="small muted">@(graded is null ? "One answer" : "Answer saved")</span>@if (graded is null) { <button class="button primary" @onclick="SubmitAsync" disabled="@(selectedAnswer < 0 || IsBusy)">@(IsBusy ? "Saving..." : "Check answer")<Icon Name="check" /></button> } else { <button class="button primary" @onclick="NextQuestion">@(questionIndex + 1 == questions.Count ? "See results" : "Next question")<Icon Name="arrow-right" /></button> }</div>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "concept")] public string? ConceptId { get; set; }
    private string? previousConceptId = "__initial";
    private Concept? focusedConcept;
    private string selectedTrack = "";
    private int questionCount = 5;
    private bool started;
    private bool finished;
    private List<QuizItem> questions = [];
    private readonly List<(QuizItem Item, bool Correct)> results = [];
    private int questionIndex;
    private int selectedAnswer = -1;
    private bool? graded;
    private Guid attemptId;
    private ElementReference questionHeading;
    private bool focusQuestion;
    private QuizItem? Current => questionIndex < questions.Count ? questions[questionIndex] : null;
    private List<QuizItem> AvailableQuestions => Catalog.All
        .Where(item => focusedConcept is not null ? item.Id == focusedConcept.Id : string.IsNullOrEmpty(selectedTrack) || item.Track == selectedTrack)
        .SelectMany(concept => concept.Quiz.Select(question => new QuizItem(concept, question))).ToList();

    protected override void OnParametersSet()
    {
        if (previousConceptId == ConceptId) return;
        previousConceptId = ConceptId;
        focusedConcept = ConceptId is not null ? Catalog.Find(ConceptId) : null;
        selectedTrack = focusedConcept?.Track ?? "";
        ResetSession();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusQuestion && started && !finished)
        {
            focusQuestion = false;
            await questionHeading.FocusAsync();
        }
    }

    private void ClearFocus()
    {
        focusedConcept = null;
        selectedTrack = "";
    }

    private void StartSession()
    {
        var pool = AvailableQuestions.ToArray();
        Random.Shared.Shuffle(pool);
        questions = pool.Take(Math.Clamp(questionCount, 1, 15)).ToList();
        if (questions.Count == 0) return;
        questionIndex = 0;
        results.Clear();
        selectedAnswer = -1;
        graded = null;
        attemptId = Guid.NewGuid();
        started = true;
        finished = false;
        focusQuestion = true;
    }

    private async Task SubmitAsync()
    {
        if (Current is null || graded is not null || selectedAnswer < 0 || IsBusy) return;
        var item = Current;
        var isCorrect = false;
        if (await SaveAsync(async () =>
            { isCorrect = await Study.SubmitAnswerAsync(attemptId, item.Concept.Id, item.Question.Id, selectedAnswer); }))
        {
            graded = isCorrect;
            results.Add((item, isCorrect));
        }
    }

    private void NextQuestion()
    {
        if (graded is null) return;
        if (++questionIndex >= questions.Count)
        {
            finished = true;
            return;
        }

        selectedAnswer = -1;
        graded = null;
        attemptId = Guid.NewGuid();
        focusQuestion = true;
    }

    private string OptionClass(int choice) => graded is not null && choice == Current?.Question.CorrectIndex
        ? "correct" : graded == false && selectedAnswer == choice ? "incorrect" : selectedAnswer == choice ? "selected" : "";
    private void EndSession() => finished = true;
    private void ResetSession()
    {
        started = false;
        finished = false;
        questions = [];
        results.Clear();
    }
}